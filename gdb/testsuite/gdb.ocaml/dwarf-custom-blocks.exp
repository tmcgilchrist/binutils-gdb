    "Continue to f_lazy_closure_combo"

# Test 22: Closure reference
gdb_test "break Test_custom_blocks_dwarf.Test_custom_blocks_dwarf.f_closure_reference" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_closure_reference"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_closure_reference (initial)"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_closure_reference (after update)"

# Test 23: List of closures
gdb_test "break Test_custom_blocks_dwarf.Test_custom_blocks_dwarf.f_closure_list" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_closure_list"

gdb_test "continue" \
