# Test OCaml DWARF 5 integration - Custom Blocks
# Tests that GDB correctly handles OCaml custom blocks: closures, lazy values,
# references, exceptions, first-class modules, weak references, hashtables

load_lib "ocaml-support.exp"

standard_testfile

# Use the pre-compiled OxCaml binary with DWARF 5 info
set oxcaml_binary "/home/tsmc/oxcaml/_build/main/oxcaml/tests/backend/oxcaml_dwarf/test_custom_blocks_dwarf.exe"

if {![file exists $oxcaml_binary]} {
    unsupported "OxCaml test binary not found: $oxcaml_binary"
    return
}

# Check if binary has DWARF debug information
set has_dwarf [expr {![catch {exec readelf -S $oxcaml_binary | grep debug_info}]}]
if {!$has_dwarf} {
    unsupported "Binary does not contain DWARF debug information"
    return
}

# Start GDB and load the external binary
gdb_exit
gdb_start
gdb_reinitialize_dir $srcdir/$subdir
gdb_file_cmd $oxcaml_binary

# Set the language to OCaml
if {![set_lang_ocaml]} {
    unsupported "Could not set language to OCaml"
    return
}

# Test 1: Start function
gdb_test "break Test_custom_blocks_dwarf.Test_custom_blocks_dwarf.f_start" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_start"

gdb_test "run" \
    ".*Breakpoint.*" \
    "Run to f_start"

# Test 2: Simple closure
gdb_test "break Test_custom_blocks_dwarf.Test_custom_blocks_dwarf.f_simple_closure" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_simple_closure"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_simple_closure"

# Test 3: Multi-capture closure
gdb_test "break Test_custom_blocks_dwarf.Test_custom_blocks_dwarf.f_multi_capture_closure" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_multi_capture_closure"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_multi_capture_closure"

# Test 4: Stateful closure (counter)
gdb_test "break Test_custom_blocks_dwarf.Test_custom_blocks_dwarf.f_stateful_closure" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_stateful_closure"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_stateful_closure"

# Test 5: Nested closure
gdb_test "break Test_custom_blocks_dwarf.Test_custom_blocks_dwarf.f_nested_closure" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_nested_closure"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_nested_closure"

# Test 6: Simple lazy value
gdb_test "break Test_custom_blocks_dwarf.Test_custom_blocks_dwarf.f_simple_lazy" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_simple_lazy"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_simple_lazy (before force)"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_simple_lazy (after force)"

# Test 7: Lazy computation
gdb_test "break Test_custom_blocks_dwarf.Test_custom_blocks_dwarf.f_lazy_computation" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_lazy_computation"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_lazy_computation (before force)"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_lazy_computation (after force)"

# Test 8: Lazy with captured values
gdb_test "break Test_custom_blocks_dwarf.Test_custom_blocks_dwarf.f_lazy_closure" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_lazy_closure"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_lazy_closure"

