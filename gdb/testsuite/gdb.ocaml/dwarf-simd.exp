# Test OCaml DWARF 5 integration - SIMD vector types
# Tests that GDB correctly handles SIMD vector types (int64x2, float32x4, etc.)
# Corresponds to OxCaml LLDB test: test_simd_dwarf.lldb

load_lib "ocaml-support.exp"

standard_testfile

# Use the pre-compiled OxCaml binary with DWARF 5 info
set oxcaml_binary "/home/tsmc/oxcaml/_build/main/oxcaml/tests/backend/oxcaml_dwarf/test_simd_dwarf.exe"

if {![file exists $oxcaml_binary]} {
    unsupported "OxCaml test binary not found: $oxcaml_binary"
    return
}

# Check if binary has DWARF debug information
set has_dwarf [expr {![catch {exec readelf -S $oxcaml_binary | grep debug_info}]}]
if {!$has_dwarf} {
    unsupported "Binary does not contain DWARF debug information"
    return
}

# Start GDB and load the external binary
gdb_exit
gdb_start
gdb_reinitialize_dir $srcdir/$subdir
gdb_file_cmd $oxcaml_binary

# Set the language to OCaml
if {![set_lang_ocaml]} {
    unsupported "Could not set language to OCaml"
    return
}

# Test 1: Start function
gdb_test "break Test_simd_dwarf.f_start" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_start"

gdb_test "run" \
    ".*Breakpoint.*" \
    "Run to f_start"

# Test 2: 128-bit SIMD types - int64x2 (unboxed)
gdb_test "break Test_simd_dwarf.f_int64x2_unboxed" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_int64x2_unboxed"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_int64x2_unboxed (1)"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_int64x2_unboxed (2)"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_int64x2_unboxed (3)"

# Test 3: 128-bit SIMD types - int32x4 (unboxed)
gdb_test "break Test_simd_dwarf.f_int32x4_unboxed" \
