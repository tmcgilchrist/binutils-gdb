# Test OCaml DWARF 5 integration - Function parameters
# Tests that function parameters are correctly displayed with DWARF type info

load_lib "ocaml-support.exp"

# Use standard OxCaml test setup for "parameters" test binary
if {[standard_oxcaml_testfile "parameters"] == -1} {
    return
}

# Test that GDB can display function parameters with proper types
gdb_test "break Test_parameters_dwarf.f_start" \
    "Breakpoint .* at .*" \
    "Set initial breakpoint"

gdb_test "run" \
    ".*Breakpoint.*" \
    "Start execution of parameters test"

pass "OCaml DWARF parameters test completed successfully"
