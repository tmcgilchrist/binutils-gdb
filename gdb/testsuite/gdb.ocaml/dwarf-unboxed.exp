# Test OCaml DWARF 5 integration - Unboxed types
# Tests unboxed variants and unboxed records

load_lib "ocaml-support.exp"

standard_testfile

# Use the pre-compiled OxCaml binary with DWARF 5 info
set oxcaml_binary "/home/tsmc/oxcaml/_build/main/oxcaml/tests/backend/oxcaml_dwarf/test_unboxed_dwarf.exe"

if {![file exists $oxcaml_binary]} {
    unsupported "OxCaml test binary not found: $oxcaml_binary"
    return
}

# Check if binary has DWARF debug information
set has_dwarf [expr {![catch {exec readelf -S $oxcaml_binary | grep debug_info}]}]
if {!$has_dwarf} {
    unsupported "Binary does not contain DWARF debug information"
    return
}

# Start GDB and load the external binary
gdb_exit
gdb_start
gdb_reinitialize_dir $srcdir/$subdir
gdb_file_cmd $oxcaml_binary

# Set the language to OCaml
if {![set_lang_ocaml]} {
    unsupported "Could not set language to OCaml"
    return
}

# Run the program to execute unboxed type tests
gdb_test "break Test_unboxed_dwarf.f_start" \
    "Breakpoint .* at .*" \
    "Set initial breakpoint"

gdb_test "run" \
    ".*Breakpoint.*" \
    "Start execution of unboxed tests"

# The test verifies that GDB can handle binaries with unboxed types
# and doesn't crash when processing DWARF information for unboxed variants
# and records

pass "OCaml DWARF unboxed types test completed successfully"
