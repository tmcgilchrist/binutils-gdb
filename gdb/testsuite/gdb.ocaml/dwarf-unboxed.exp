# Test OCaml DWARF 5 integration - Unboxed types
# Tests unboxed variants and unboxed records

load_lib "ocaml-support.exp"

# Use standard OxCaml test setup for "unboxed" test binary
if {[standard_oxcaml_testfile "unboxed"] == -1} {
    return
}

# Run the program to execute unboxed type tests
gdb_test "break Test_unboxed_dwarf.f_start" \
    "Breakpoint .* at .*" \
    "Set initial breakpoint"

gdb_test "run" \
    ".*Breakpoint.*" \
    "Start execution of unboxed tests"

# The test verifies that GDB can handle binaries with unboxed types
# and doesn't crash when processing DWARF information for unboxed variants
# and records

pass "OCaml DWARF unboxed types test completed successfully"
