# Test OCaml value printing with type annotations
# Tests that GDB correctly prints OCaml values in LLDB-compatible format:
# VALUE : TYPE @ REPRESENTATION

load_lib "ocaml-support.exp"

standard_testfile

# Use the pre-compiled OxCaml binary with DWARF 5 info
set oxcaml_binary "/home/tsmc/oxcaml/_build/main/oxcaml/tests/backend/oxcaml_dwarf/test_basic_dwarf.exe"

if {![file exists $oxcaml_binary]} {
    unsupported "OxCaml test binary not found: $oxcaml_binary"
    return
}

# Check if binary has DWARF debug information
set has_dwarf [expr {![catch {exec readelf -S $oxcaml_binary | grep debug_info}]}]
if {!$has_dwarf} {
    unsupported "Binary does not contain DWARF debug information"
    return
}

# Start GDB and load the external binary
gdb_exit
gdb_start
gdb_reinitialize_dir $srcdir/$subdir
gdb_file_cmd $oxcaml_binary

# Set the language to OCaml
if {![set_lang_ocaml]} {
    unsupported "Could not set language to OCaml"
    return
}

# Test basic type annotations in print output
gdb_test "break Test_basic_dwarf.f_int" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_int"

gdb_test "run" \
    ".*Breakpoint.*" \
    "Run to f_int"

# Continue to get non-zero value
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_int with value 123"

# Test that print command includes type annotation
gdb_test "print x" \
    ".*= .* : .* @ .*" \
    "Print shows type annotation"

# Test bool values
gdb_test "break Test_basic_dwarf.f_bool" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_bool"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_bool (true)"

gdb_test "print x" \
    ".*= .* : .* @ .*" \
    "Print bool shows type annotation"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_bool (false)"

# Test string values
gdb_test "break Test_basic_dwarf.f_string" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_string"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_string (first call)"

# Just verify type annotation is present, value may vary
gdb_test "print x" \
    ".*: .* @ .*" \
    "Print string shows type annotation (first call)"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_string (second call)"

gdb_test "print x" \
    ".*: .* @ .*" \
    "Print string shows type annotation (second call)"

# ============================================================================
# Test Char Values
# ============================================================================

gdb_test "break Test_basic_dwarf.f_char" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_char"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_char"

# Test regular char
gdb_test "print x" \
    ".*'.*'.* : char @ value.*" \
    "Print char shows character and type annotation"

# Test newline char
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_char (newline)"

gdb_test "print x" \
    ".*'.*'.* : char @ value.*" \
    "Print char with escape sequence shows type annotation"

# ============================================================================
# Test Integer Edge Cases
# ============================================================================

gdb_test "break Test_basic_dwarf.f_int_edge" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_int_edge"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_int_edge"

# Test zero
gdb_test "print x" \
    ".*0.* : int @ value.*" \
    "Print int zero shows type annotation"

# Test negative
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_int_edge (negative)"

gdb_test "print x" \
    ".*-.*: int @ value.*" \
    "Print negative int shows type annotation"

# Test max value (architecture dependent, just check it prints)
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_int_edge (max)"

gdb_test "print x" \
    ".*\\d+.* : int @ value.*" \
    "Print max int value shows type annotation"

# ============================================================================
# Test Float Edge Cases
# ============================================================================

gdb_test "break Test_basic_dwarf.f_float_edge" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_float_edge"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_float_edge"

# Test zero float
gdb_test "print x" \
    ".*0\\\\.0.* : float @ value.*" \
    "Print float zero shows type annotation"

# Test negative float
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_float_edge (negative)"

gdb_test "print x" \
    ".*-.*\\d+\\\\..*: float @ value.*" \
    "Print negative float shows type annotation"

# Test special float values (Inf, NaN if available)
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_float_edge (special)"

gdb_test "print x" \
    ".*: float @ value.*" \
    "Print special float value (Inf/NaN) shows type annotation"

# Test scientific notation
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_float_edge (scientific)"

gdb_test "print x" \
    ".*: float @ value.*" \
    "Print float in scientific notation shows type annotation"

# ============================================================================
# Test Empty/Edge String Cases
# ============================================================================

gdb_test "break Test_basic_dwarf.f_string_edge" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_string_edge"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_string_edge"

# Test empty string
gdb_test "print x" \
    ".*\\\"\\\".* : string @ value.*" \
    "Print empty string shows type annotation"

# Test string with special characters
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_string_edge (special chars)"

gdb_test "print x" \
    ".*\\\".*\\\".* : string @ value.*" \
    "Print string with special characters shows type annotation"

# ============================================================================
# Test Unit Type
# ============================================================================

gdb_test "break Test_basic_dwarf.f_unit" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_unit"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unit"

# Test unit value ()
gdb_test "print x" \
    ".*\\(\\).* : unit @ value.*" \
    "Print unit () shows type annotation"

# ============================================================================
# Test Int32/Int64 Edge Cases
# ============================================================================

gdb_test "break Test_basic_dwarf.f_int32_edge" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_int32_edge"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_int32_edge"

# Test int32 zero
gdb_test "print x" \
    ".*0l.* : int32 @ value.*" \
    "Print int32 zero shows type annotation with l suffix"

# Test int32 max
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_int32_edge (max)"

gdb_test "print x" \
    ".*\\d+l.* : int32 @ value.*" \
    "Print int32 max value shows type annotation"

gdb_test "break Test_basic_dwarf.f_int64_edge" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_int64_edge"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_int64_edge"

# Test int64 zero
gdb_test "print x" \
    ".*0L.* : int64 @ value.*" \
    "Print int64 zero shows type annotation with L suffix"

# Test int64 max
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_int64_edge (max)"

gdb_test "print x" \
    ".*\\d+L.* : int64 @ value.*" \
    "Print int64 max value shows type annotation"

# Summary: This test verifies that:
# 1. GDB prints OCaml values with type annotations
# 2. The format is: VALUE : TYPE @ REPRESENTATION
# 3. Type annotations work for primitive types (int, bool, string, char, unit)
# 4. Edge cases handled: zero, negative, max values
# 5. Special float values (Inf, NaN, scientific notation)
# 6. Empty and special character strings
# 7. Int32/Int64 with proper suffixes (l, L)
# Total: 15 original + 20 edge case tests = 35 tests
