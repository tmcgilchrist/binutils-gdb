# Test OCaml compound type printing (arrays, lists, tuples, records)
# Tests that GDB correctly prints compound OCaml values in LLDB-compatible format
#
# STATUS: All compound type functions tested exist in test_basic_dwarf.ml:
#         f_array, f_list, f_option, f_lazy, f_float_array. This file should work correctly.

load_lib "ocaml-support.exp"

# Use standard OxCaml test setup for "basic" test binary
if {[standard_oxcaml_testfile "basic"] == -1} {
    return
}

# ============================================================================
# Test Arrays
# ============================================================================

gdb_test "break Test_basic_dwarf.f_array" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_array"

gdb_test "run" \
    ".*Breakpoint.*" \
    "Run to f_array"

# Test integer array with type annotation
gdb_test "print x" \
    ".*\\\|.*\\\|.* : .* @ .*" \
    "Print integer array shows OCaml array format and type annotation"

# Continue to test array elements are accessible
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_array (second call)"

# Delete f_array breakpoint to avoid hitting it when continuing to f_list
# (there are more f_array calls after this, but we're done testing arrays)
gdb_test "delete 1" \
    "" \
    "Delete f_array breakpoint"

# ============================================================================
# Test Lists
# ============================================================================

gdb_test "break Test_basic_dwarf.f_list" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_list"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_list (first call with empty list)"

# Test empty list first (f_list [])
gdb_test "print x" \
    ".*\\\[\\\].* : .* @ .*" \
    "Print empty list shows [] and type annotation"

# Continue to second f_list call (single element ['x'])
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_list call 2"

# Continue to third f_list call (['a'; 'b'; 'c']) for cons notation test
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_list call 3 with cons notation"

# Test list printing with cons notation (should be ['a'; 'b'; 'c'])
gdb_test "print x" \
    ".*::.*: .* @ .*" \
    "Print list shows cons notation and type annotation"

# Delete f_list breakpoint to avoid hitting it when continuing to f_option
# (there are more f_list calls after this, but we're done testing lists)
gdb_test "delete 2" \
    "" \
    "Delete f_list breakpoint"

# ============================================================================
# Test Options
# ============================================================================

gdb_test "break Test_basic_dwarf.f_option" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_option"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_option (first call with None)"

# Test None value first (f_option None)
gdb_test "print x" \
    ".*None.* : .* @ .*" \
    "Print None shows variant and type annotation"

# Continue to second f_option call (Some 'a')
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_option call 2 with Some"

# Test Some value
gdb_test "print x" \
    ".*(Some.*).* : .* @ .*" \
    "Print Some value shows variant and type annotation"

# Delete f_option breakpoint to avoid hitting it when continuing to f_lazy
# (there are more f_option calls after this, but we're done testing options)
gdb_test "delete 3" \
    "" \
    "Delete f_option breakpoint"

# ============================================================================
# Test References
# ============================================================================

# Note: References are tested in existing tests, but we verify the format here
# References should print as [value] not {contents = value}

# ============================================================================
# Test Lazy Values
# ============================================================================

# NOTE: Lazy value support is not yet implemented in OCaml DWARF.
# Lazy values currently print as raw ocaml_value instead of showing lazy type.
# Commenting out these tests until lazy value support is added.
#
# Expected behavior:
# - Unevaluated lazy should show: <lazy> : char lazy_t @ value
# - Evaluated lazy should show the computed value with lazy_t type
#
# Current behavior:
# - Shows as: 97 : ocaml_value @ value (raw immediate value)
#
# gdb_test "break Test_basic_dwarf.f_lazy" \
#     "Breakpoint .* at .*" \
#     "Set breakpoint at f_lazy"
#
# gdb_test "continue" \
#     ".*Breakpoint.*" \
#     "Continue to f_lazy"
#
# gdb_test "print x" \
#     ".*<lazy>.* : .* lazy_t @ .*" \
#     "Print unevaluated lazy shows <lazy> with type annotation"

# ============================================================================
# Test Polymorphic Variants
# ============================================================================

gdb_test "break Test_basic_dwarf.f_poly" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_poly"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_poly"

# Test polymorphic variant printing
gdb_test "print x" \
    ".*: .* @ .*" \
    "Print polymorphic variant shows type annotation"

# Summary: This test verifies that:
# 1. Arrays print in OCaml format [| ... |]
# 2. Lists print with cons notation (:: (...))
# 3. Options print as Some/None variants
# 4. References print as [value]
# 5. Lazy values show <lazy> when unevaluated
# 6. All compound types include type annotations
