# Test OCaml DWARF 5 integration - Phase 1 features
# Tests basic variant and record type printing with DWARF information

load_lib "ocaml-support.exp"

# Use custom OxCaml binary path (not the standard test suite binaries)
set oxcaml_binary "/home/tsmc/oxcaml-hacking/demo.exe"

# Check binary exists and has DWARF, then load it
if {![check_oxcaml_binary_exists $oxcaml_binary]} {
    return
}
if {![check_binary_has_dwarf $oxcaml_binary]} {
    return
}
if {[prepare_for_oxcaml_testing $oxcaml_binary] != 0} {
    return
}

# Test 1: Check that GDB recognizes the OCaml language from DWARF
gdb_test "show language" \
    {The current source language is "ocaml".*} \
    "GDB recognizes OCaml language from DWARF"

# Test 2: Check that info functions doesn't crash with OCaml binaries
# Use a more specific pattern to avoid buffer overflow from listing all functions
gdb_test "info functions camlDemo" \
    ".*caml.*" \
    "Can list OCaml functions without crashing"

# Note: Expression evaluation tests are in expression.exp
# These basic tests just verify the DWARF infrastructure works correctly
