gdb_test "print x" \
    ".*-#.*s.* : .* @ bits32.*" \
    "Print unboxed float32 shows negative value"

# ============================================================================
# Test Unboxed Int32 (int32#)
# ============================================================================

gdb_test "break Test_unboxed_dwarf.f_unboxed_int32" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_unboxed_int32"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_int32"

# Test unboxed int32 shows # prefix and @ bits32
gdb_test "print x" \
    ".*#\\\d+l.* : .* @ bits32.*" \
    "Print unboxed int32 shows # prefix with l suffix and @ bits32"

# Test unboxed int32 with zero
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_int32 (zero)"

gdb_test "print x" \
    ".*#0l.* : .* @ bits32.*" \
    "Print unboxed int32 #0l shows zero value"

# Test unboxed int32 with negative
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_int32 (negative)"

gdb_test "print x" \
    ".*-#\\\d+l.* : .* @ bits32.*" \
    "Print unboxed int32 shows negative value"

