# Test OCaml unboxed type printing
# Tests that GDB correctly prints unboxed OCaml values with # prefix
# Format: #VALUE : TYPE @ REPRESENTATION
#
# STATUS: All functions tested here exist in test_unboxed_dwarf.ml with
#         comprehensive edge cases. This file should work correctly.

load_lib "ocaml-support.exp"

# Use standard OxCaml test setup for "unboxed" test binary
if {[standard_oxcaml_testfile "unboxed"] == -1} {
    return
}

# ============================================================================
# Test Unboxed Float (float#)
# ============================================================================

gdb_test "break Test_unboxed_dwarf.f_unboxed_float" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_unboxed_float"

gdb_test "run" \
    ".*Breakpoint.*" \
    "Run to f_unboxed_float"

# Test unboxed float shows # prefix and @ float64
gdb_test "print x" \
    ".*#.*: .* @ float64.*" \
    "Print unboxed float shows # prefix and @ float64"

# Test unboxed float with zero
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_float call 2 with zero value"

gdb_test "print x" \
    ".*#0.* : .* @ float64.*" \
    "Print unboxed float #0 shows zero value"

# Test unboxed float with negative
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_float call 3 with negative value"

gdb_test "print x" \
    ".*-#.*: .* @ float64.*" \
    "Print unboxed float shows negative value"

# Test unboxed float with large value (scientific notation)
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_float call 4 with large value"

gdb_test "print x" \
    ".*#.*: .* @ float64.*" \
    "Print unboxed float with large value"

