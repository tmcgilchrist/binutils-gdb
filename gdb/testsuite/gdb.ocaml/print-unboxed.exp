# ============================================================================
# Test Unboxed Nativeint (nativeint#)
# ============================================================================
# NOTE: Testing nativeint before int32/int64 to match execution order in test_unboxed_dwarf.ml

gdb_test "break Test_unboxed_dwarf.f_unboxed_nativeint" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_unboxed_nativeint"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_nativeint"

# Test unboxed nativeint shows # prefix and @ word (first call: #0n)
gdb_test "print x" \
    ".*#0n.*: .* @ word.*" \
    "Print unboxed nativeint #0n shows zero value"

# Test unboxed nativeint with large value (second call: #0x123456789abcdefn)
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_nativeint call 2 with large hex value"

gdb_test "print x" \
    ".*#.*n.*: .* @ word.*" \
    "Print unboxed nativeint shows # prefix and @ word"

# Test unboxed nativeint with negative (third call: -#999n)
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_nativeint call 3 with negative value"

gdb_test "print x" \
    ".*-#.*n.*: .* @ word.*" \
    "Print unboxed nativeint shows negative value"

# ============================================================================
# Test Unboxed Int32 (int32#)
# ============================================================================

gdb_test "break Test_unboxed_dwarf.f_unboxed_int32" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_unboxed_int32"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_int32"

# Test unboxed int32 shows # prefix and @ bits32 (first call: #0l)
gdb_test "print x" \
    ".*#0l.* : .* @ bits32.*" \
    "Print unboxed int32 #0l shows zero value"

# Test unboxed int32 with large value (second call: #0x12345678l)
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_int32 call 2 with large hex value"

gdb_test "print x" \
    ".*#\\\d+l.* : .* @ bits32.*" \
    "Print unboxed int32 shows # prefix with l suffix and @ bits32"

# Test unboxed int32 with negative (third call: -#456l)
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_int32 call 3 with negative value"

gdb_test "print x" \
    ".*-#\\\d+l.* : .* @ bits32.*" \
    "Print unboxed int32 shows negative value"

