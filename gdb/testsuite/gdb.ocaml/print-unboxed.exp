# Test OCaml unboxed type printing
# Tests that GDB correctly prints unboxed OCaml values with # prefix
# Format: #VALUE : TYPE @ REPRESENTATION
#
# STATUS: All functions tested here exist in test_unboxed_dwarf.ml with
#         comprehensive edge cases. This file should work correctly.

load_lib "ocaml-support.exp"

standard_testfile

# Use the pre-compiled OxCaml unboxed test binary with DWARF 5 info
set oxcaml_binary "/home/tsmc/oxcaml/_build/main/oxcaml/tests/backend/oxcaml_dwarf/test_unboxed_dwarf.exe"

if {![file exists $oxcaml_binary]} {
    unsupported "OxCaml unboxed test binary not found: $oxcaml_binary"
    return
}

# Check if binary has DWARF debug information
set has_dwarf [expr {![catch {exec readelf -S $oxcaml_binary | grep debug_info}]}]
if {!$has_dwarf} {
    unsupported "Binary does not contain DWARF debug information"
    return
}

# Start GDB and load the external binary
gdb_exit
gdb_start
gdb_reinitialize_dir $srcdir/$subdir
gdb_file_cmd $oxcaml_binary

# Set the language to OCaml
if {![set_lang_ocaml]} {
    unsupported "Could not set language to OCaml"
    return
}

# ============================================================================
# Test Unboxed Float (float#)
# ============================================================================

gdb_test "break Test_unboxed_dwarf.f_unboxed_float" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_unboxed_float"

gdb_test "run" \
    ".*Breakpoint.*" \
    "Run to f_unboxed_float"

# Test unboxed float shows # prefix and @ float64
gdb_test "print x" \
    ".*#.*\\\\..*: .* @ float64.*" \
    "Print unboxed float shows # prefix and @ float64"

# Test unboxed float with zero
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_float (zero)"

gdb_test "print x" \
    ".*#0\\\\.0.* : .* @ float64.*" \
    "Print unboxed float #0.0 shows zero value"

# Test unboxed float with negative
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_float (negative)"

gdb_test "print x" \
    ".*-#.*\\\\..*: .* @ float64.*" \
    "Print unboxed float shows negative value"

# Test unboxed float with large value (scientific notation)
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_float (large)"

gdb_test "print x" \
    ".*#.*: .* @ float64.*" \
    "Print unboxed float with large value"

