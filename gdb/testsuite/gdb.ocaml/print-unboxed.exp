# ============================================================================
# Test Simple Unboxed Product
# ============================================================================

gdb_test "break Test_unboxed_dwarf.f_simple_product" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_simple_product"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_simple_product"

# Test unboxed products are decomposed into separate parameters
# Each parameter should have # prefix and type annotation
# Use info args to see all parameters (names include unique compiler-generated prefixes)
gdb_test "info args" \
    ".*_unboxed0.*#.*: .* @ .*" \
    "Print first unboxed product field shows # prefix"

gdb_test "info args" \
    ".*_unboxed1.*#.*: .* @ .*" \
    "Print second unboxed product field shows # prefix"

# Skip remaining calls to f_simple_product (called 3 times total)
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_simple_product call 2 with zero values"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_simple_product call 3 with negative values"

# ============================================================================
# Test Mixed Product (boxed + unboxed)
# ============================================================================

gdb_test "break Test_unboxed_dwarf.f_mixed_product" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_mixed_product"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_mixed_product"

# Test mixed products have both boxed and unboxed fields
# Boxed bool should show type annotation without # prefix
gdb_test "info args" \
    ".*_unboxed0.*#.*: .* @ .*" \
    "Print unboxed field in mixed product shows # prefix"

gdb_test "info args" \
    ".*_unboxed1.*(true|false).*: .* @ value.*" \
    "Print boxed bool field in mixed product shows type annotation"

# Skip remaining call to f_mixed_product (called 2 times total)
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_mixed_product call 2 with zero/false values"

# ============================================================================
# Test Unboxed Record
# ============================================================================

gdb_test "break Test_unboxed_dwarf.f_simple_record" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_simple_record"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_simple_record"

# Test unboxed record fields are decomposed
gdb_test "info args" \
    ".*_unboxed0.*#.*: .* @ .*" \
    "Print first unboxed record field shows # prefix"

gdb_test "info args" \
    ".*_unboxed1.*#.*: .* @ .*" \
    "Print second unboxed record field shows # prefix"

# Skip remaining calls to f_simple_record (called 3 times total)
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_simple_record call 2 with zero values"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_simple_record call 3 with negative values"

# ============================================================================
# Test Mixed Record (boxed + unboxed fields)
# ============================================================================

gdb_test "break Test_unboxed_dwarf.f_mixed_record" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_mixed_record"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_mixed_record"

# Test mixed record has both boxed and unboxed fields
# mixed_record = #{ a: int64#; b: bool; c: float# }
# unboxed0 = int64#, unboxed1 = bool (boxed), unboxed2 = float#
gdb_test "info args" \
    ".*_unboxed0.*#.*L.*: .* @ bits64.*" \
    "Print first unboxed field (int64#) in mixed record shows # prefix"

# Boxed bool field should show type annotation without # prefix
gdb_test "info args" \
    ".*_unboxed1.*(true|false).*: .* @ value.*" \
    "Print boxed bool field in mixed record shows type annotation"

# Third unboxed float# field
gdb_test "info args" \
    ".*_unboxed2.*#.*: .* @ float64.*" \
    "Print second unboxed field (float#) in mixed record shows # prefix"

# Summary: This test verifies that:
# 1. All unboxed types show # prefix
# 2. Unboxed floats show @ float64
# 3. Unboxed 32-bit types show @ bits32
# 4. Unboxed 64-bit types show @ bits64
# 5. Unboxed products/records are decomposed into separate parameters
# 6. Mixed boxed/unboxed structures work correctly
# 7. All values include type annotations
# 8. Edge cases: zero, negative, min/max values for all types
# 9. Special values: large float values, scientific notation
# 10. Min/max testing for int8 (127/-128) and int16 (32767/-32768)
# Total: 17 original + 27 edge case tests = 44 tests
