# Test OCaml record type printing
# Tests that GDB correctly prints OCaml records in LLDB-compatible format
# Format: { field = value; ... } with type annotations
#
# STATUS: All record functions tested exist in test_datatypes_dwarf.ml with
#         the expected fields and values. This file should work correctly.

load_lib "ocaml-support.exp"

# Use standard OxCaml test setup for "datatypes" test binary
if {[standard_oxcaml_testfile "datatypes"] == -1} {
    return
}

# ============================================================================
# Test Basic Records
# ============================================================================

gdb_test "break Test_datatypes_dwarf.f_basic_record" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_basic_record"

gdb_test "run" \
    ".*Breakpoint.*" \
    "Run to f_basic_record"

# Test basic record with positive values
gdb_test "print x" \
    ".*\\{.*x.*=.*42.*y.*=.*3\\\\.14.*\\}.* : basic_record @ value.*" \
    "Print basic record {x=42; y=3.14} shows fields and type annotation"

# Test basic record with zero values
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_basic_record (zero values)"

gdb_test "print x" \
    ".*\\{.*x.*=.*0.*y.*=.*0\\\\.0.*\\}.* : basic_record @ value.*" \
    "Print basic record {x=0; y=0.0} shows zero values"

# Test basic record with negative values
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_basic_record (negative values)"

gdb_test "print x" \
    ".*\\{.*x.*=.*-123.*y.*=.*-2\\\\.5.*\\}.* : basic_record @ value.*" \
    "Print basic record {x=-123; y=-2.5} shows negative values"

# ============================================================================
# Test Mixed Boxed/Unboxed Records
# ============================================================================

gdb_test "break Test_datatypes_dwarf.f_mixed_record" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_mixed_record"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_mixed_record"

# Test mixed record with boxed and unboxed fields
gdb_test "print x" \
    ".*\\{.*a.*=.*42.*c.*=.*true.*d.*=.*1000l.*b.*=.*#3\\\\.14.*\\}.* : mixed_record @ value.*" \
    "Print mixed record {a=42; c=true; d=1000l; b=#3.14} shows mixed fields"

# Test mixed record with zero/false values
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_mixed_record (zeros)"

gdb_test "print x" \
    ".*\\{.*a.*=.*0.*c.*=.*false.*d.*=.*0l.*b.*=.*#0\\\\.0.*\\}.* : mixed_record @ value.*" \
    "Print mixed record with zero/false values"

# ============================================================================
# Test Unboxed Record (Simple)
# ============================================================================

gdb_test "break Test_datatypes_dwarf.f_unboxed_record_simple" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_unboxed_record_simple"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_record_simple"

# Test unboxed record with single field
gdb_test "print x" \
    ".*\\{.*value.*=.*42.*\\}.* : unboxed_record_simple @ value.*" \
    "Print unboxed record {value=42} shows field"

# Test unboxed record with zero
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_record_simple (zero)"

gdb_test "print x" \
    ".*\\{.*value.*=.*0.*\\}.* : unboxed_record_simple @ value.*" \
    "Print unboxed record {value=0} shows zero"

# Test unboxed record with negative
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_record_simple (negative)"

gdb_test "print x" \
    ".*\\{.*value.*=.*-999.*\\}.* : unboxed_record_simple @ value.*" \
    "Print unboxed record {value=-999} shows negative"

# ============================================================================
# Test Nested Records (Unboxed Record Complex)
# ============================================================================

gdb_test "break Test_datatypes_dwarf.f_unboxed_record_complex" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_unboxed_record_complex"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_record_complex"

# Test nested record
gdb_test "print x" \
    ".*\\{.*data.*=.*\\{.*x.*=.*10.*y.*=.*2\\\\.0.*\\}.*\\}.* : unboxed_record_complex @ value.*" \
    "Print nested record {data={x=10; y=2.0}} shows nested structure"

# Test nested record with zeros
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_record_complex (zeros)"

gdb_test "print x" \
    ".*\\{.*data.*=.*\\{.*x.*=.*0.*y.*=.*0\\\\.0.*\\}.*\\}.* : unboxed_record_complex @ value.*" \
    "Print nested record with zero values"

# ============================================================================
# Test Records with Unboxed Tuple Fields
# ============================================================================

gdb_test "break Test_datatypes_dwarf.f_unboxed_tuple_field" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_unboxed_tuple_field"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_tuple_field"

# Test record with unboxed tuple fields
gdb_test "print x" \
    ".*\\{.*f\\\\.#1.*=.*24.*s.*=.*\\\"hello\\\".*b.*=.*true.*f\\\\.#0.*=.*#42L.*\\}.* : t @ value.*" \
    "Print record with unboxed tuple fields {f.#1=24; s=\"hello\"; b=true; f.#0=#42L}"

# Test record with unboxed tuple - edge case values
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_tuple_field (edge case)"

gdb_test "print x" \
    ".*\\{.*f\\\\.#1.*=.*1.*s.*=.*\\\"\\\".*b.*=.*false.*f\\\\.#0.*=.*#0L.*\\}.* : t @ value.*" \
    "Print record with unboxed tuple {f.#1=1; s=\"\"; b=false; f.#0=#0L}"

# Test record with unboxed tuple - negative values
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_tuple_field (negative)"

gdb_test "print x" \
    ".*\\{.*f\\\\.#1.*=.*-100.*s.*=.*\\\"world\\\".*b.*=.*true.*f\\\\.#0.*=.*#10L.*\\}.* : t @ value.*" \
    "Print record with unboxed tuple {f.#1=-100; s=\"world\"; b=true; f.#0=#10L}"

# Summary: This test verifies that:
# 1. Basic records print with field names and values
# 2. Records handle edge cases (zero, negative values)
# 3. Mixed boxed/unboxed records work correctly
# 4. Unboxed records print properly
# 5. Nested records show nested structure
# 6. Records with unboxed tuple fields show special field names (f.#0, f.#1)
# 7. All records include type annotations
# Total: 15 tests
