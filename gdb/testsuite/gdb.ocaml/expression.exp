# Test OCaml expression parsing.
# NOTE: The tests here intentionally do not require an OCaml compiler.

load_lib "ocaml-support.exp"

proc test_ocaml_integer_literals {} {
    # Test valid OCaml integer literals are accepted.

    gdb_test "print 42" " = 42"
    gdb_test "print 123456" " = 123456"
    gdb_test "print -999" " = -999"

    # Hexadecimal
    gdb_test "print 0x2A" " = 42"
    gdb_test "print 0xFF" " = 255"

    # Octal
    gdb_test "print 0o52" " = 42"
    gdb_test "print 0o377" " = 255"

    # Binary
    gdb_test "print 0b101010" " = 42"
    gdb_test "print 0b11111111" " = 255"
}

proc test_ocaml_float_literals {} {
    # Test valid OCaml float literals are accepted.

    gdb_test "print 3.14" " = 3.14.*"
    gdb_test "print 1.0" " = 1"
    gdb_test "print 2.5e10" " = 2.5e\\+10.*"
    gdb_test "print 1.5e-5" " = 1.5e-0?5.*"
}

proc test_ocaml_string_literals {} {
    # Test OCaml string literals.

    gdb_test {print "hello"} { = "hello"}
    gdb_test {print "world"} { = "world"}
    gdb_test {print ""} { = ""}
}

proc test_ocaml_boolean_literals {} {
    # Test OCaml boolean literals.
    # In OCaml runtime: true = 3, false = 1

    gdb_test "print true" " = 3"
    gdb_test "print false" " = 1"
}

proc test_ocaml_unit_literal {} {
    # Test OCaml unit literal ().
    # In OCaml runtime: () = 1

    gdb_test "print ()" " = 1" "print unit value"
}

proc test_ocaml_arithmetic {} {
    # Test arithmetic operations.

    gdb_test "print 2 + 3" " = 5"
    gdb_test "print 10 - 4" " = 6"
    gdb_test "print 3 * 7" " = 21"
    gdb_test "print 20 / 5" " = 4"
    gdb_test "print 17 % 5" " = 2"
    gdb_test "print -5" " = -5"
}

proc test_ocaml_comparison {} {
    # Test comparison operations.

    gdb_test "print 5 < 10" " = 3" "less than returns true (3)"
    gdb_test "print 10 < 5" " = 1" "less than returns false (1)"
    gdb_test "print 5 > 10" " = 1" "greater than returns false"
    gdb_test "print 10 > 5" " = 3" "greater than returns true"
    gdb_test "print 5 = 5" " = 3" "equality returns true"
    gdb_test "print 5 = 6" " = 1" "equality returns false"
}

proc test_ocaml_logical {} {
    # Test logical operations.

    gdb_test "print true && true" " = 3" "logical and of true and true"
    gdb_test "print true && false" " = 1" "logical and of true and false"
    gdb_test "print true || false" " = 3" "logical or of true and false"
    gdb_test "print false || false" " = 1" "logical or of false and false"
}

proc test_ocaml_conditionals {} {
    # Test if-then-else expressions.

    gdb_test "print if true then 42 else 0" " = 42"
    gdb_test "print if false then 1 else 99" " = 99"
    gdb_test "print if 5 < 10 then 1 else 2" " = 1"
}

proc test_ocaml_lists {} {
    # Test list syntax.
    # Empty list = 1, cons creates pairs

    gdb_test "print \\\[\\\]" " = 1" "empty list"
    gdb_test "print \\\[42\\\]" ".*" "single element list"
}

proc test_ocaml_tuples {} {
    # Test tuple syntax.

    gdb_test "print (1, 2)" ".*" "2-tuple"
    gdb_test "print (1, 2, 3)" ".*" "3-tuple"
}

proc test_ocaml_arrays {} {
    # Test array syntax [|...|].

    gdb_test "print \\\[||\\\]" " = 0" "empty array"
    gdb_test "print \\\[|42|\\\]" ".*" "single element array"
    gdb_test "print \\\[|1; 2|\\\]" ".*" "two element array"
}

proc test_ocaml_records {} {
    # Test record syntax {...}.

    gdb_test "print {x=1}" ".*" "single field record"
    gdb_test "print {x=1; y=2}" ".*" "two field record"
}

proc test_ocaml_parentheses {} {
    # Test parenthesized expressions.

    gdb_test "print (42)" " = 42"
    gdb_test "print (2 + 3) * 4" " = 20"
    gdb_test "print 2 + (3 * 4)" " = 14"
}

clean_restart

if {[set_lang_ocaml]} {
    test_ocaml_integer_literals
    test_ocaml_float_literals
    test_ocaml_string_literals
    test_ocaml_boolean_literals
    test_ocaml_unit_literal
    test_ocaml_arithmetic
    test_ocaml_comparison
    test_ocaml_logical
    test_ocaml_conditionals
    test_ocaml_lists
    test_ocaml_tuples
    test_ocaml_arrays
    test_ocaml_records
    test_ocaml_parentheses
} else {
    warning "OCaml expression tests suppressed."
}
