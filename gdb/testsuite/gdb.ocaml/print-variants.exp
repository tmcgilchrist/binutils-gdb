# Test OCaml variant type printing
# Tests that GDB correctly prints OCaml variants in LLDB-compatible format
# Format: CONSTRUCTOR or (CONSTRUCTOR value) with type annotations
#
# STATUS: All variant functions tested exist in test_datatypes_dwarf.ml with
#         the expected constructors and values. This file should work correctly.

load_lib "ocaml-support.exp"

# Use standard OxCaml test setup for "datatypes" test binary
if {[standard_oxcaml_testfile "datatypes"] == -1} {
    return
}

# ============================================================================
# Test Simple Variants - No Data Constructors
# ============================================================================

gdb_test "break Test_datatypes_dwarf.f_simple_variant" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_simple_variant"

gdb_test "run" \
    ".*Breakpoint.*" \
    "Run to f_simple_variant"

# Test variant with no data - constructor A
gdb_test "print x" \
    ".*A.* : simple_variant @ value.*" \
    "Print simple variant A shows constructor and type annotation"

# Test variant with no data - constructor B
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_simple_variant (B)"

gdb_test "print x" \
    ".*B.* : simple_variant @ value.*" \
    "Print simple variant B shows constructor and type annotation"

# ============================================================================
# Test Simple Variants - With Data
# ============================================================================

# Test variant with int data
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_simple_variant (C with int)"

gdb_test "print x" \
    ".*(C.*42.*).* : simple_variant @ value.*" \
    "Print simple variant (C 42) shows constructor with int data"

# Test variant with float data
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_simple_variant (D with float)"

gdb_test "print x" \
    ".*(D.*3\\\\.14.*).* : simple_variant @ value.*" \
    "Print simple variant (D 3.14) shows constructor with float data"

# ============================================================================
# Test Complex Variants
# ============================================================================

gdb_test "break Test_datatypes_dwarf.f_complex_variant" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_complex_variant"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_complex_variant"

# Test Empty constructor
gdb_test "print x" \
    ".*Empty.* : complex_variant @ value.*" \
    "Print complex variant Empty shows constructor"

# Test Single with int
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_complex_variant (Single)"

gdb_test "print x" \
    ".*(Single.*123.*).* : complex_variant @ value.*" \
    "Print complex variant (Single 123) shows constructor with data"

# Test Pair with tuple
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_complex_variant (Pair)"

gdb_test "print x" \
    ".*(Pair.*(42.*1\\\\.5.*)).* : complex_variant @ value.*" \
    "Print complex variant (Pair (42, 1.5)) shows constructor with tuple"

# Test Record variant
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_complex_variant (Record)"

gdb_test "print x" \
    ".*(Record.*\\{.*x.*=.*10.*y.*=.*2\\\\.5.*\\}).* : complex_variant @ value.*" \
    "Print complex variant (Record {x=10; y=2.5}) shows constructor with record"

# Test Mixed boxed/unboxed variant
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_complex_variant (Mixed)"

gdb_test "print x" \
    ".*(Mixed.*\\{.*a.*=.*100.*c.*=.*true.*b.*=.*#3\\\\.14.*\\}).* : complex_variant @ value.*" \
    "Print complex variant (Mixed) shows mixed boxed/unboxed fields"

# ============================================================================
# Test Unboxed Variants - Float64
# ============================================================================

gdb_test "break Test_datatypes_dwarf.f_unboxed_variant_float" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_unboxed_variant_float"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_variant_float"

# Test unboxed float variant
gdb_test "print x" \
    ".*(Simple.*#4\\\\.1.*).* : unboxed_variant_float @ float64.*" \
    "Print unboxed variant (Simple #4.1) shows # prefix and @ float64"

# Test unboxed float variant with zero
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_variant_float (zero)"

gdb_test "print x" \
    ".*(Simple.*#0\\\\.0.*).* : unboxed_variant_float @ float64.*" \
    "Print unboxed variant (Simple #0.0) shows zero value"

# Test unboxed float variant with negative
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_variant_float (negative)"

gdb_test "print x" \
    ".*(Simple.*-#2\\\\.5.*).* : unboxed_variant_float @ float64.*" \
    "Print unboxed variant (Simple -#2.5) shows negative value"

# ============================================================================
# Test Unboxed Variants - Int32
# ============================================================================

gdb_test "break Test_datatypes_dwarf.f_unboxed_variant_int" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_unboxed_variant_int"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_variant_int"

# Test unboxed int32 variant
gdb_test "print x" \
    ".*(Complex.*#42l.*).* : unboxed_variant_int @ bits32.*" \
    "Print unboxed variant (Complex #42l) shows # prefix and @ bits32"

# Test unboxed int32 variant with zero
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_variant_int (zero)"

gdb_test "print x" \
    ".*(Complex.*#0l.*).* : unboxed_variant_int @ bits32.*" \
    "Print unboxed variant (Complex #0l) shows zero value"

# ============================================================================
# Test Unboxed Variants - Value Types (Boxed)
# ============================================================================

gdb_test "break Test_datatypes_dwarf.f_unboxed_variant_value_int" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_unboxed_variant_value_int"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_variant_value_int"

# Test unboxed variant with boxed int
gdb_test "print x" \
    ".*(ValueInt.*42.*).* : unboxed_variant_value_int @ value.*" \
    "Print unboxed variant (ValueInt 42) with boxed value"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_variant_value_int (zero)"

gdb_test "print x" \
    ".*(ValueInt.*0.*).* : unboxed_variant_value_int @ value.*" \
    "Print unboxed variant (ValueInt 0) shows zero"

# Test unboxed variant with string
gdb_test "break Test_datatypes_dwarf.f_unboxed_variant_value_string" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_unboxed_variant_value_string"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_variant_value_string"

gdb_test "print x" \
    ".*(ValueString.*\\\"hello\\\".*).* : unboxed_variant_value_string @ value.*" \
    "Print unboxed variant (ValueString \"hello\") with string"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_variant_value_string (empty)"

gdb_test "print x" \
    ".*(ValueString.*\\\"\\\".*).* : unboxed_variant_value_string @ value.*" \
    "Print unboxed variant (ValueString \"\") with empty string"

# Test unboxed variant with bool
gdb_test "break Test_datatypes_dwarf.f_unboxed_variant_value_bool" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_unboxed_variant_value_bool"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_variant_value_bool"

gdb_test "print x" \
    ".*(ValueBool.*true.*).* : unboxed_variant_value_bool @ value.*" \
    "Print unboxed variant (ValueBool true) with bool"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_unboxed_variant_value_bool (false)"

gdb_test "print x" \
    ".*(ValueBool.*false.*).* : unboxed_variant_value_bool @ value.*" \
    "Print unboxed variant (ValueBool false) shows false"

# ============================================================================
# Test Nested Variants
# ============================================================================

gdb_test "break Test_datatypes_dwarf.f_nested_variant" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_nested_variant"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_nested_variant"

# Test leaf node
gdb_test "print x" \
    ".*(Leaf.*42.*).* : nested_variant @ value.*" \
    "Print nested variant (Leaf 42) shows leaf node"

# Test node with nested structure
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_nested_variant (Node)"

gdb_test "print x" \
    ".*(Node.*\\{.*left.*=.*(Leaf.*1.*).*right.*=.*(Leaf.*2.*).*value.*=.*3\\\\.14.*\\}).* : nested_variant @ value.*" \
    "Print nested variant (Node) shows recursive structure"

# ============================================================================
# Test Option Variant
# ============================================================================

gdb_test "break Test_datatypes_dwarf.f_option_variant" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_option_variant"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_option_variant"

# Test None
gdb_test "print x" \
    ".*None.* : int option_variant @ value.*" \
    "Print option variant None shows constructor"

# Test Some
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_option_variant (Some)"

gdb_test "print x" \
    ".*(Some.*42.*).* : int option_variant @ value.*" \
    "Print option variant (Some 42) shows constructor with value"

# ============================================================================
# Test Either Variant
# ============================================================================

gdb_test "break Test_datatypes_dwarf.f_either" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_either"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_either"

# Test Left
gdb_test "print x" \
    ".*(Left.*42.*).* : \\(int, string\\) either @ value.*" \
    "Print either variant (Left 42) shows left constructor"

# Test Right
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_either (Right)"

gdb_test "print x" \
    ".*(Right.*\\\"hello\\\".*).* : \\(int, string\\) either @ value.*" \
    "Print either variant (Right \"hello\") shows right constructor"

# Summary: This test verifies that:
# 1. Simple variants without data print correctly (A, B)
# 2. Simple variants with data print correctly ((C 42), (D 3.14))
# 3. Complex variants with tuples/records print correctly
# 4. Mixed boxed/unboxed variants work
# 5. Unboxed variants show # prefix and correct representation
# 6. Nested recursive variants print correctly
# 7. Option and Either types work
# 8. All variants include type annotations
# Total: 30 tests
