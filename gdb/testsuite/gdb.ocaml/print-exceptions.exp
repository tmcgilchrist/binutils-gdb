# Test OCaml exception value printing
# Tests that GDB correctly prints OCaml exceptions in LLDB-compatible format
# Format: { exn = { name = "..."; id = N }; raw = [...] } : exn @ value
#
# STATUS: All exception functions tested exist in test_datatypes_dwarf.ml:
#         f_exception_specific and f_exception_poly. This file should work correctly.

load_lib "ocaml-support.exp"

standard_testfile

# Use the pre-compiled OxCaml datatypes test binary with DWARF 5 info
set oxcaml_binary "/home/tsmc/oxcaml/_build/main/oxcaml/tests/backend/oxcaml_dwarf/test_datatypes_dwarf.exe"

if {![file exists $oxcaml_binary]} {
    unsupported "OxCaml datatypes test binary not found: $oxcaml_binary"
    return
}

# Check if binary has DWARF debug information
set has_dwarf [expr {![catch {exec readelf -S $oxcaml_binary | grep debug_info}]}]
if {!$has_dwarf} {
    unsupported "Binary does not contain DWARF debug information"
    return
}

# Start GDB and load the external binary
gdb_exit
gdb_start
gdb_reinitialize_dir $srcdir/$subdir
gdb_file_cmd $oxcaml_binary

# Set the language to OCaml
if {![set_lang_ocaml]} {
    unsupported "Could not set language to OCaml"
    return
}

# ============================================================================
# Test Custom Exceptions
# ============================================================================

gdb_test "break Test_datatypes_dwarf.f_exception_specific" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_exception_specific"

gdb_test "run" \
    ".*Breakpoint.*" \
    "Run to f_exception_specific"

# Test simple exception with no data
gdb_test "print x" \
    ".*\\{.*exn.*=.*raw.*=.*\\}.* : exn @ value.*" \
    "Print simple exception shows structure"

# Test exception with int data
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_exception_specific (with int)"

gdb_test "print x" \
    ".*\\{.*exn.*=.*raw.*=.*\\}.* : exn @ value.*" \
    "Print exception with int shows structure"

# Test exception with string data
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_exception_specific (with string)"

gdb_test "print x" \
    ".*\\{.*exn.*=.*raw.*=.*\\}.* : exn @ value.*" \
    "Print exception with string shows structure"

# Test exception with multiple values
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_exception_specific (with multiple)"

gdb_test "print x" \
    ".*\\{.*exn.*=.*raw.*=.*\\}.* : exn @ value.*" \
    "Print exception with multiple values shows structure"

# Test exception with record data
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_exception_specific (with record)"

gdb_test "print x" \
    ".*\\{.*exn.*=.*raw.*=.*\\}.* : exn @ value.*" \
    "Print exception with record shows structure"

# Test exception with unboxed record data
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_exception_specific (with unboxed record)"

gdb_test "print x" \
    ".*\\{.*exn.*=.*raw.*=.*\\}.* : exn @ value.*" \
    "Print exception with unboxed record shows structure"

# ============================================================================
# Test Standard Exceptions
# ============================================================================

# Test Failure exception
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_exception_specific (Failure)"

gdb_test "print x" \
    ".*\\{.*exn.*=.*raw.*=.*\\}.* : exn @ value.*" \
    "Print Failure exception shows structure"

# Test Invalid_argument exception
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_exception_specific (Invalid_argument)"

gdb_test "print x" \
    ".*\\{.*exn.*=.*raw.*=.*\\}.* : exn @ value.*" \
    "Print Invalid_argument exception shows structure"

# ============================================================================
# Test Polymorphic Exception Values
# ============================================================================

gdb_test "break Test_datatypes_dwarf.f_exception_poly" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_exception_poly"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_exception_poly"

# Test polymorphic exception - simple
gdb_test "print x" \
    ".*: .* @ value.*" \
    "Print polymorphic exception (simple) shows type annotation"

# Test polymorphic exception with int
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_exception_poly (with int)"

gdb_test "print x" \
    ".*: .* @ value.*" \
    "Print polymorphic exception with int shows type annotation"

# Test polymorphic exception with string
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_exception_poly (with string)"

gdb_test "print x" \
    ".*: .* @ value.*" \
    "Print polymorphic exception with string shows type annotation"

# Test polymorphic exception with multiple values
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_exception_poly (multiple)"

gdb_test "print x" \
    ".*: .* @ value.*" \
    "Print polymorphic exception with multiple values"

# Test polymorphic exception with record
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_exception_poly (record)"

gdb_test "print x" \
    ".*: .* @ value.*" \
    "Print polymorphic exception with record"

# Test polymorphic exception with unboxed
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_exception_poly (unboxed)"

gdb_test "print x" \
    ".*: .* @ value.*" \
    "Print polymorphic exception with unboxed"

# Test polymorphic exception - polymorphic failure
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_exception_poly (polymorphic failure)"

gdb_test "print x" \
    ".*: .* @ value.*" \
    "Print polymorphic failure exception"

# Summary: This test verifies that:
# 1. Exceptions show proper structure {exn = ...; raw = ...}
# 2. Custom exceptions with various data types work
# 3. Standard exceptions (Failure, Invalid_argument) work
# 4. Polymorphic exception values print with type annotations
# 5. Exception payloads (int, string, records, multiple values) handled
# 6. All exception values include type annotations
# NOTE: Exception name/id fields require runtime exception table lookup (see ocaml-lang.c:1985)
# Total: 15 tests
