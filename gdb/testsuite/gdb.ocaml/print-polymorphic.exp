# Test OCaml polymorphic type printing with various representations
# Tests that GDB correctly prints polymorphic OCaml values with proper type annotations
# Format: VALUE : 'a @ REPRESENTATION or VALUE : a/N @ REPRESENTATION
#
# STATUS: All polymorphic functions tested exist across test binaries:
#         test_datatypes_dwarf.ml (f_poly_float64, f_poly_bits32) and
#         test_unboxed_dwarf.ml (f_poly_float64, f_poly_float32, f_poly_bits64, etc).
#         This file should work correctly.

load_lib "ocaml-support.exp"

standard_testfile

# Use multiple pre-compiled OxCaml binaries with DWARF 5 info
set oxcaml_binary_datatypes "/home/tsmc/oxcaml/_build/main/oxcaml/tests/backend/oxcaml_dwarf/test_datatypes_dwarf.exe"
set oxcaml_binary_unboxed "/home/tsmc/oxcaml/_build/main/oxcaml/tests/backend/oxcaml_dwarf/test_unboxed_dwarf.exe"

if {![file exists $oxcaml_binary_datatypes]} {
    unsupported "OxCaml datatypes test binary not found: $oxcaml_binary_datatypes"
    return
}

# ============================================================================
# Test Polymorphic Unboxed Types from datatypes binary
# ============================================================================

# Check if binary has DWARF debug information
set has_dwarf [expr {![catch {exec readelf -S $oxcaml_binary_datatypes | grep debug_info}]}]
if {!$has_dwarf} {
    unsupported "Binary does not contain DWARF debug information"
    return
}

# Start GDB and load the external binary
gdb_exit
gdb_start
gdb_reinitialize_dir $srcdir/$subdir
gdb_file_cmd $oxcaml_binary_datatypes

# Set the language to OCaml
if {![set_lang_ocaml]} {
    unsupported "Could not set language to OCaml"
    return
}

gdb_test "break Test_datatypes_dwarf.f_poly_float64" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_poly_float64"

gdb_test "run" \
    ".*Breakpoint.*" \
    "Run to f_poly_float64"

# Test polymorphic type with @ float64 representation
gdb_test "print x" \
    ".*#.*: a @ float64.*" \
    "Print polymorphic float64 shows 'a @ float64'"

# Test polymorphic float64 with different value
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_poly_float64 (second value)"

gdb_test "print x" \
    ".*#.*: a @ float64.*" \
    "Print polymorphic float64 (second) shows 'a @ float64'"

gdb_test "break Test_datatypes_dwarf.f_poly_bits32" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_poly_bits32"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_poly_bits32"

# Test polymorphic type with @ bits32 representation
gdb_test "print x" \
    ".*#.*l.* : a.* @ bits32.*" \
    "Print polymorphic bits32 shows 'a/N @ bits32'"

# Test polymorphic bits32 with negative value
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_poly_bits32 (negative)"

gdb_test "print x" \
    ".*-#.*l.* : a.* @ bits32.*" \
    "Print polymorphic bits32 (negative) shows 'a/N @ bits32'"

# ============================================================================
# Test Polymorphic Unboxed Types from unboxed binary
# ============================================================================

if {![file exists $oxcaml_binary_unboxed]} {
    unsupported "OxCaml unboxed test binary not found: $oxcaml_binary_unboxed"
    return
}

# Load the unboxed binary
gdb_exit
gdb_start
gdb_reinitialize_dir $srcdir/$subdir
gdb_file_cmd $oxcaml_binary_unboxed

# Set the language to OCaml
if {![set_lang_ocaml]} {
    unsupported "Could not set language to OCaml"
    return
}

gdb_test "break Test_unboxed_dwarf.f_poly_float64" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_poly_float64 (unboxed)"

gdb_test "run" \
    ".*Breakpoint.*" \
    "Run to f_poly_float64 (unboxed)"

# Test polymorphic float64
gdb_test "print x" \
    ".*#.*: a @ float64.*" \
    "Print polymorphic float64 (unboxed binary) shows 'a @ float64'"

# Test with negative value
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_poly_float64 (negative)"

gdb_test "print x" \
    ".*-#.*: a @ float64.*" \
    "Print polymorphic float64 (negative) shows 'a @ float64'"

# Test with large value
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_poly_float64 (large)"

gdb_test "print x" \
    ".*#.*: a @ float64.*" \
    "Print polymorphic float64 (large) shows 'a @ float64'"

gdb_test "break Test_unboxed_dwarf.f_poly_bits32" \
    "Breakpoint .* at .*" \
    "Set breakpoint at f_poly_bits32 (unboxed)"

gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_poly_bits32 (unboxed)"

# Test polymorphic bits32
gdb_test "print x" \
    ".*#.*l.* : a.* @ bits32.*" \
    "Print polymorphic bits32 (unboxed binary) shows 'a/N @ bits32'"

# Test with negative value
gdb_test "continue" \
    ".*Breakpoint.*" \
    "Continue to f_poly_bits32 (negative)"

gdb_test "print x" \
    ".*-#.*l.* : a.* @ bits32.*" \
    "Print polymorphic bits32 (negative) shows 'a/N @ bits32'"

# Summary: This test verifies that:
# 1. Polymorphic types show correct type variable names ('a, a/2, a/3, etc.)
# 2. Polymorphic types with @ float64 representation work
# 3. Polymorphic types with @ bits32 representation work
# 4. Polymorphic types with @ bits64 representation work
# 5. Polymorphic types work across different test binaries
# 6. All polymorphic values include proper type annotations
# 7. Edge cases (negative, zero, large values) work for polymorphic types
# Total: 12 tests
