# Auxiliary function to set the language to OCaml.
# The result is 1 (true) for success, 0 (false) for failure.

proc set_lang_ocaml {} {
    if {[gdb_test_no_output "set language ocaml"]} {
	return 0
    }
    if {[gdb_test "show language" \
	     [string_to_regexp {The current source language is "ocaml".}] \
	     {set language to "ocaml"}]} {
	return 0
    }
    return 1
}

# OCaml version of runto_main.
# OCaml programs typically start at a generated entry point.

proc ocaml_runto_main { } {
    # OCaml compiled programs have various entry points depending on
    # the runtime and linking. For now, use the standard entry.
    return [runto main]
}
